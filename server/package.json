    "drizzle-orm": "0.45.1",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "firebase-admin": "^13.8.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.1",
    "pg": "^8.20.0",
    "resend": "^6.19.0",
    "typescript": "^5.8.3",
    "zod": "^4.4.2"
  },
